{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nnb-probe-v4",
  "definitions": {
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["azimuthDeg", "altitudeDeg", "fovDeg"],
      "properties": {
        "azimuthDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "altitudeDeg": { "type": "number", "minimum": -89, "maximum": 89 },
        "fovDeg": { "type": "number", "minimum": 15, "maximum": 120 }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitudeDeg", "longitudeDeg", "heightM"],
      "properties": {
        "latitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitudeDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "heightM": { "type": "number", "minimum": -500, "maximum": 10000 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instantUtc", "timeZone", "objectId", "observer", "refraction"],
      "properties": {
        "instantUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "timeZone": { "type": "string", "pattern": "^[A-Za-z0-9_+./-]{1,80}$" },
        "objectId": { "enum": ["Sun", "Moon", "Mars"] },
        "observer": { "$ref": "#/definitions/observer" },
        "refraction": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "lessonId", "contentVersion", "initialObservation"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "lessonId": { "const": "p0-host-probe" },
        "contentVersion": { "const": "0.1.0" },
        "initialObservation": { "$ref": "#/definitions/observation" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "lessonId", "contentVersion", "observation", "camera", "playbackRate", "sceneId", "level", "mode", "locationHistory"],
      "properties": {
        "schemaVersion": { "const": 4 },
        "lessonId": { "const": "p0-host-probe" },
        "contentVersion": { "const": "0.1.0" },
        "observation": { "$ref": "#/definitions/observation" },
        "camera": { "$ref": "#/definitions/camera" },
        "playbackRate": { "enum": [-86400, -3600, -60, -1, -0.1, 0, 0.1, 60, 3600, 86400, 1] },
        "sceneId": { "enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"] },
        "level": { "enum": ["basic", "extended", "expert"] },
        "mode": { "enum": ["explore", "learn"] },
        "locationHistory": { "type": "array", "maxItems": 100, "items": { "$ref": "#/definitions/observer" } }
      }
    }
  }
}
