{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nnb-scene-content-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "oreRef", "goals", "levels", "blocks", "initialObservation", "activityIds", "mediaIds", "plainText"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"] },
    "oreRef": { "type": "string", "minLength": 1, "maxLength": 120 },
    "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "levels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["basic", "extended", "expert"] } },
    "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/block" } },
    "initialObservation": { "$ref": "nnb-probe#/definitions/observation" },
    "activityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][0-9]{2,3}$" } },
    "mediaIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "plainText": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,80}$" },
        "type": { "enum": ["text", "illustration", "video", "simulation"] },
        "text": { "type": "string", "minLength": 1 },
        "mediaId": { "type": "string", "minLength": 1 },
        "altText": { "type": "string", "minLength": 1 },
        "transcript": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "illustration" } } }, "then": { "required": ["mediaId", "altText"] } },
        { "if": { "properties": { "type": { "const": "video" } } }, "then": { "required": ["mediaId", "transcript"] } },
        { "if": { "properties": { "type": { "const": "simulation" } } }, "then": { "required": ["altText"] } }
      ]
    }
  }
}
