{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nnb-glossary-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "terms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "terms": { "type": "array", "minItems": 20, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "term", "simple", "extended", "sceneId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z-]+$" },
        "term": { "type": "string", "minLength": 3 },
        "simple": { "type": "string", "minLength": 10 },
        "extended": { "type": "string", "minLength": 10 },
        "sceneId": { "enum": ["E1", "E2", "E3", "E4", "E5", "E6"] }
      }
    } }
  }
}
