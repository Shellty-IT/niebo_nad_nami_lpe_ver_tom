{
  "name": "niebo-nad-nami-lpe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "setup": "npm ci --prefix app",
    "check": "npm run check --prefix app",
    "test": "npm test --prefix app",
    "test:e2e": "npm run test:e2e --prefix app",
    "build": "node lpe/build.mjs",
    "verify": "node lpe/verify.mjs",
    "release": "npm run build && npm run verify"
  }
}
